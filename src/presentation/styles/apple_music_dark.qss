/* ===================================================================
   meloSync - Apple Music Dark Theme (Modern, Minimalist, Glassmorphism)
   =================================================================== */

* {
    font-family: "Segoe UI", "Segoe UI Variable Text", system-ui, -apple-system, sans-serif;
    color: #f5f5f7;
    font-size: 13px;
    selection-background-color: #fa2d48;
    selection-color: #ffffff;
}

QMainWindow, QWidget#CentralWidget {
    background-color: #121214;
}

/* -------------------------------------------------------------------
   Sidebar
   ------------------------------------------------------------------- */
QWidget#SidebarWidget {
    background-color: #1a1a1d;
    border-right: 1px solid rgba(255, 255, 255, 0.07);
}

QLabel#AppTitleLabel {
    font-size: 19px;
    font-weight: 700;
    color: #ffffff;
    padding-left: 6px;
    letter-spacing: -0.5px;
}

QLabel#AppSubtitleLabel {
    font-size: 11px;
    color: #fa2d48;
    font-weight: 600;
    padding-left: 6px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

QPushButton.SidebarNavButton {
    background-color: transparent;
    color: #a1a1a6;
    border: none;
    border-radius: 9px;
    text-align: left;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton.SidebarNavButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QPushButton.SidebarNavButton:checked, QPushButton.SidebarNavButton[active="true"] {
    background-color: #fa2d48;
    color: #ffffff;
    font-weight: 600;
}

/* -------------------------------------------------------------------
   Views & Containers
   ------------------------------------------------------------------- */
QStackedWidget {
    background-color: #121214;
}

QWidget#ViewHeader {
    background-color: transparent;
    padding-bottom: 8px;
}

QLabel#ViewTitle {
    font-size: 26px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.5px;
}

QLabel#ViewSubtitle {
    font-size: 13px;
    color: #86868b;
}

/* -------------------------------------------------------------------
   Inputs & Search Bar
   ------------------------------------------------------------------- */
QLineEdit {
    background-color: #232328;
    color: #f5f5f7;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
}

QLineEdit:focus {
    border: 1px solid #fa2d48;
    background-color: #27272d;
}

QLineEdit#SearchInput {
    font-size: 14px;
    padding: 11px 16px;
}

/* -------------------------------------------------------------------
   Buttons
   ------------------------------------------------------------------- */
QPushButton {
    background-color: #2a2a30;
    color: #f5f5f7;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #36363e;
    border-color: rgba(255, 255, 255, 0.15);
}

QPushButton:pressed {
    background-color: #202025;
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    color: #55555c;
    border-color: transparent;
}

/* Accent Button (Apple Music Red/Pink) */
QPushButton.AccentButton {
    background-color: #fa2d48;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 6px 16px;
    font-weight: 600;
}

QPushButton.AccentButton:hover {
    background-color: #ff425d;
}

QPushButton.AccentButton:pressed {
    background-color: #d8243c;
}

/* Secondary Button */
QPushButton.SecondaryButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 12px;
}

QPushButton.SecondaryButton:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

/* -------------------------------------------------------------------
   Table Action Buttons (No Clipping, Generous Spacing)
   ------------------------------------------------------------------- */
QPushButton.TableDownloadButton {
    background-color: #fa2d48;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0px 16px;
    font-size: 13px;
    font-weight: 600;
    min-height: 36px;
    min-width: 130px;
}

QPushButton.TableDownloadButton:hover {
    background-color: #ff425d;
}

QPushButton.TableDownloadButton:pressed {
    background-color: #d8243c;
}

QPushButton.TableDownloadButton:disabled {
    background-color: #2ea043;
    color: #ffffff;
}

QPushButton.TablePlayButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 0px 8px;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton.TablePlayButton:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
}

QPushButton.TablePlayButton:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QPushButton.TableEditButton {
    background-color: rgba(250, 45, 72, 0.12);
    color: #fa2d48;
    border: 1px solid rgba(250, 45, 72, 0.3);
    border-radius: 8px;
    padding: 0px 8px;
    font-size: 12px;
    font-weight: 600;
    min-height: 34px;
}

QPushButton.TableEditButton:hover {
    background-color: #fa2d48;
    border-color: #fa2d48;
    color: #ffffff;
}

QPushButton.TableEditButton:pressed {
    background-color: #d8243c;
    color: #ffffff;
}

QPushButton.TableFolderButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 0px 8px;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton.TableFolderButton:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
}

QPushButton.TableFolderButton:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QPushButton.TableDeleteButton {
    background-color: rgba(255, 69, 58, 0.12);
    color: #ff5b52;
    border: 1px solid rgba(255, 69, 58, 0.35);
    border-radius: 8px;
    padding: 0px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 34px;
}

QPushButton.TableDeleteButton:hover {
    background-color: rgba(255, 69, 58, 0.28);
    border-color: #ff453a;
    color: #ffffff;
}

QPushButton.TableDeleteButton:pressed {
    background-color: #d8243c;
    color: #ffffff;
}

/* -------------------------------------------------------------------
   Cards & Frames
   ------------------------------------------------------------------- */
QFrame.ItemCard {
    background-color: #1a1a1e;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 10px;
}

QFrame.ItemCard:hover {
    background-color: #222227;
    border-color: rgba(255, 255, 255, 0.12);
}

/* -------------------------------------------------------------------
   Tables & TreeViews
   ------------------------------------------------------------------- */
QTableWidget, QTableView {
    background-color: #151518;
    gridline-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    selection-background-color: rgba(250, 45, 72, 0.25);
    selection-color: #ffffff;
    outline: none;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QTableWidget::item:selected {
    background-color: rgba(250, 45, 72, 0.22);
}

QHeaderView::section {
    background-color: #1a1a1e;
    color: #86868b;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 12px;
}

/* -------------------------------------------------------------------
   Progress Bars
   ------------------------------------------------------------------- */
QProgressBar {
    background-color: #222228;
    border: none;
    border-radius: 5px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #fa2d48, stop:1 #ff5e78);
    border-radius: 5px;
}

/* -------------------------------------------------------------------
   Persistent Bottom Bar
   ------------------------------------------------------------------- */
QWidget#BottomBarWidget {
    background-color: #161619;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding: 8px 16px;
}

QLabel#BottomStatusTitle {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
}

QLabel#BottomStatusSubtitle {
    font-size: 11px;
    color: #86868b;
}

/* -------------------------------------------------------------------
   Badges (State Indicators)
   ------------------------------------------------------------------- */
QLabel.BadgePending {
    background-color: #2c2c32;
    color: #aeaeb2;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

QLabel.BadgeDownloading {
    background-color: rgba(10, 132, 255, 0.22);
    color: #409cff;
    border: 1px solid rgba(10, 132, 255, 0.4);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

QLabel.BadgeProcessing {
    background-color: rgba(191, 90, 242, 0.22);
    color: #da8fff;
    border: 1px solid rgba(191, 90, 242, 0.4);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

QLabel.BadgeMetadata {
    background-color: rgba(255, 159, 10, 0.22);
    color: #ffb340;
    border: 1px solid rgba(255, 159, 10, 0.4);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

QLabel.BadgeCompleted {
    background-color: rgba(48, 209, 88, 0.22);
    color: #4cd964;
    border: 1px solid rgba(48, 209, 88, 0.4);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

QLabel.BadgeError {
    background-color: rgba(255, 69, 58, 0.22);
    color: #ff6961;
    border: 1px solid rgba(255, 69, 58, 0.4);
    border-radius: 7px;
    padding: 2px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 28px;
    min-width: 140px;
}

/* -------------------------------------------------------------------
   Scrollbars
   ------------------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.15);
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* -------------------------------------------------------------------
   Metadata Edit Dialog
   ------------------------------------------------------------------- */
QDialog#MetadataEditDialog {
    background-color: #141416;
}

QDialog#MetadataEditDialog QLineEdit {
    background-color: #202024;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
}

QDialog#MetadataEditDialog QLineEdit:focus {
    border-color: #fa2d48;
    background-color: #242429;
}

QDialog#MetadataEditDialog QListWidget {
    background-color: #18181c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 6px;
    outline: none;
}

QDialog#MetadataEditDialog QListWidget::item {
    border-radius: 8px;
    margin-bottom: 4px;
    border: 1px solid transparent;
}

QDialog#MetadataEditDialog QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
}

QDialog#MetadataEditDialog QListWidget::item:selected {
    background-color: rgba(250, 45, 72, 0.2);
    border-color: #fa2d48;
}

